{
  "name": "rico",
  "version": "0.1.0",
  "description": "Rich comments: review rendered markdown in GitHub PRs, with comments that span paragraphs",
  "type": "module",
  "bin": {
    "rico": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "e2e": "node e2e/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.18",
    "github-markdown-css": "^5.9.0",
    "markdown-it": "^14.1.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@primer/octicons": "^19.42.0",
    "playwright": "1.63.0"
  },
  "optionalDependencies": {
    "@terrastruct/d2": "0.1.33",
    "mermaid": "11.17.2"
  }
}
